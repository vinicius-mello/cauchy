# ---------------------------------------------------------------- várias variáveis (mpoly)
# Contextos e acesso a termos em mpoly.c; o argumento mctx é o contexto do anel.
fmpz_mpoly_add             fmpz_mpoly     fmpz_mpoly fmpz_mpoly mctx
fmpz_mpoly_sub             fmpz_mpoly     fmpz_mpoly fmpz_mpoly mctx
fmpz_mpoly_mul             fmpz_mpoly     fmpz_mpoly fmpz_mpoly mctx
fmpz_mpoly_neg             fmpz_mpoly     fmpz_mpoly mctx
fmpz_mpoly_pow             fmpz_mpoly     fmpz_mpoly ui mctx   = fmpz_mpoly_pow_ui ! expoente grande demais
fmpz_mpoly_scalar_mul      fmpz_mpoly     fmpz_mpoly fmpz mctx = fmpz_mpoly_scalar_mul_fmpz
